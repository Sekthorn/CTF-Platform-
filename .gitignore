# Dependency directories
node_modules/
.pnp
.pnp.js

# Build and distribution outputs
dist/
build/
coverage/
.eslintcache

# Environment and sensitive keys
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Database backups & local dumps (preserve Prisma schema migrations)
backups/
*.sql.gz
*.sql
!**/prisma/migrations/**/*.sql

# Python bytecode & virtual environments (challenge labs)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker runtime & Certbot local storage
infrastructure/certbot/conf/*
!infrastructure/certbot/conf/.gitkeep
infrastructure/certbot/www/*
!infrastructure/certbot/www/.gitkeep

# Editor and OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# TypeScript build info
*.tsbuildinfo

# Private challenge walkthroughs & solutions (Owner only)
docs/CHALLENGE_SOLUTIONS_WALKTHROUGH.md
docs/CHALLENGE_SOLUTIONS_WALKTHROUGH.pdf
*SOLUTIONS*
*solutions*
*WALKTHROUGH*
*walkthrough*
