# WebSec CTF - Backend Environment Variables
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database Configuration (MySQL 8.4 on Docker port 3307)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=websec_ctf
DB_USER=websec_user
DB_PASSWORD=websec_password

# Prisma Connection URL
DATABASE_URL="mysql://websec_user:websec_password@localhost:3307/websec_ctf"

# Redis Configuration (Redis 7.4)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# JWT Authentication & Session Security
JWT_SECRET=websec_ctf_super_secret_jwt_key_2026_change_in_prod
JWT_REFRESH_SECRET=websec_ctf_super_secret_refresh_key_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
