# ==============================================================================
# WebSec CTF - Unified Environment Configuration Template
# ==============================================================================
# Quickstart (One-Command Deployment like OWASP Juice Shop):
#   cp .env.example .env
#   docker compose up -d --build
#
# Access:
#   Frontend UI & Platform: http://localhost
#   Backend REST API:       http://localhost/api/v1 (or direct: http://localhost:3000/api/v1)
#   Swagger API Docs:       http://localhost/api/v1/docs
#   Service Health:         http://localhost/api/v1/health
# ==============================================================================

# --- Environment Mode ---
NODE_ENV=production
DOMAIN=localhost

# --- Frontend Application ---
# Mapped port on host machine (Port 80 serves the complete platform at http://localhost)
FRONTEND_PORT=80
# In Docker, frontend routes API requests through Nginx proxy via relative /api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="WebSec CTF"

# --- Backend Application ---
BACKEND_PORT=3000
API_PREFIX=api/v1

# --- Database Configuration (MySQL 8.4) ---
# When running with Docker Compose, containers communicate via the internal 'mysql' service name.
DB_HOST=mysql
# Host-mapped port 3307 avoids conflicts with any native MySQL instance running on 3306
DB_PORT=3307
DB_NAME=websec_ctf
DB_USER=websec_user
DB_PASSWORD=websec_password
DB_ROOT_PASSWORD=root_password

# Database Connection URL (Auto-resolved inside Docker backend container)
DATABASE_URL="mysql://websec_user:websec_password@mysql:3306/websec_ctf"

# --- Redis In-Memory Cache (7.4) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# --- JWT Authentication & Session Security ---
# In production, replace with secure 64-character random strings (e.g. openssl rand -hex 32)
JWT_SECRET=websec_ctf_super_secret_jwt_key_2026_change_in_prod
JWT_REFRESH_SECRET=websec_ctf_super_secret_refresh_key_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# --- Initial Admin Setup & Cookie Security ---
SETUP_SECRET=websec_admin_initial_setup_secret_2026_change_in_prod
COOKIE_SECURE=false
